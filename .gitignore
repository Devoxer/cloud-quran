coverage/

# Playwright
test-results/
playwright-report/
**/e2e/screenshots/

# Wrangler — local D1/R2/KV state (`wrangler dev`, `d1 migrations apply --local`) and the
# local-only secrets file wrangler reads for `dev`. `.dev.vars` carries BETTER_AUTH_SECRET (the
# key that signs real sessions, story 5-5 — it replaced 5-4's DEV_AUTH_SECRET), which exists in
# no env block of wrangler.toml and must never be committed.
.wrangler/
.dev.vars
.dev.vars.*

# Audio pipeline temp files
tmp/

# agent worktrees — transient, never committed
.claude/worktrees/

# turbo build cache
.turbo/
**/.turbo/

# Native projects are CNG output — regenerated by `expo prebuild`, never committed.
# Committing them means a hand-edit survives once, on one machine, and evaporates on the
# next prebuild. The durable form of any native change is a config plugin or a patch.
# Anchored to the app: bare `ios/`/`android/` match ANY nested directory of that name, so a
# future src/.../ios/ or an asset folder would be silently uncommitted. These are Expo CNG
# output (prebuild regenerates them) and exist only under apps/expo.
/apps/expo/ios/
/apps/expo/android/
.bmad-loop/runs/
.bmad-loop/cache/
# .bmad-loop/policy.toml is TRACKED on purpose. `bmad-loop init` gitignores it (it can carry a
# machine-local [mux] backend and TUI pane sizes) and prints a note suggesting `git rm --cached`.
# Ignore that note here: [verify] commands DEFAULTS TO EMPTY, so an untracked policy means a fresh
# clone runs the loop with no lint, no typecheck and no tests, and commits the result. One machine,
# one developer — the sharing hazard is empty and the unverified-commit hazard is not.
_bmad/render/

# Playwright MCP scratch output (console logs / page snapshots) — never source
.playwright-mcp/
