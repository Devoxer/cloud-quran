        "expo-audio",
        "react-native-screens"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    }
  },
  "private": true,
  "_comment_port": "Story 5-1 review: `start` was a bare `expo start`, which binds 8081 — the very port CLAUDE.md warns wisdom-fruits owns, and the doc claimed an EXPO_DEV_PORT variable that existed nowhere. Two dev clients on one machine race for the bundle, and a wisdom-fruits build pulling Cloud Quran JS fails on missing native modules. All three entry points now default to 8082, `run:ios`/`run:android` included — they start their OWN bundler and ignore the `start` script, which is how the collision survived the first fix. Override with EXPO_DEV_PORT."
}
