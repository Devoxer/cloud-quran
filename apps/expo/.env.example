# Cloud Quran — environment skeleton. NEVER commit actual values.
#
# Values live in the committed, encrypted apps/expo/secrets.sops.yaml (sops + age). The store
# exists but every value is EMPTY — the 5-1 review created it, populating it is the owner's job.
# Until at least one value is filled, `secrets:push:*` exits with "no non-empty KEY=value lines",
# which is the expected state and not a broken key:
#   pnpm secrets:edit expo        # enter/update values (decrypt-on-open, creates on first run)
#   pnpm secrets:push:local       # regenerates apps/expo/.env.local
#   pnpm secrets:push:expo        # pushes EXPO_PUBLIC_* to EAS
# This skeleton stays so a fresh clone sees the expected keys before an age-key restore.

# ── Client (EXPO_PUBLIC_ — bundled into the app, visible to users) ────────────

# Cloudflare R2 — recitation audio CDN. Nothing reads this yet; epic 7 wires playback.
EXPO_PUBLIC_R2_URL=

# Content origin — read by lib/config.ts + contentUrl(). Was missing from this skeleton.
EXPO_PUBLIC_CONTENT_URL=

# Apple Services ID — WEB Sign in with Apple. NOTHING ON THE CLIENT READS IT, and that is not an
# oversight: the web/desktop leg is an OAuth REDIRECT whose credentials live entirely on the
# worker (APPLE_SERVICE_ID / APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY in
# apps/worker/secrets.sops.yaml). The native leg needs nothing either — its id-token audience is
# the iOS bundle identifier, whose capability is already registered. Kept as a reminder that the
# Services ID exists; the worker is where it goes.
EXPO_PUBLIC_APPLE_SERVICE_ID=

# Sentry — opt-in crash reporting. Off until the user enables it.
EXPO_PUBLIC_SENTRY_DSN=

# Worker — the API and, from story 5-4, the data path (D1 + Drizzle; Better Auth in 5-5). It is
# NOT "cost safety and account deletion only" — sprint-change-proposal-2026-08-20 reversed that.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google Sign-In client ids, read through `lib/config.ts` (never `process.env` at a call site —
# `babel-preset-expo` inlines EXPO_PUBLIC_* at transform time, so any other read is frozen at
# build and invisible to a test). They are NOT secrets: they ship in the binary and are the
# AUDIENCE the worker verifies a native id token against, so the same list goes to the worker as
# GOOGLE_CLIENT_IDS. The client SECRET is the worker's alone and never reaches here.
#
# They gate only the NATIVE leg. Web and desktop redirect, and need no client id at all — which
# is why `sign-in.tsx` offers the Google button on web regardless.
# app.json's `iosUrlScheme` is the iOS id reversed, and must be kept in step with it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Deliberately absent ───────────────────────────────────────────────────────
# No RevenueCat, Paddle or PostHog keys. Cloud Quran is free and waqf-funded with
# zero third-party analytics, advertising or tracking SDKs (PRD NFR8, NFR28).
# If you find yourself adding one of those keys here, the change is wrong.

# ── Server-side (worker secrets — never EXPO_PUBLIC_) ─────────────────────────
# These do NOT belong in this file or in any `.env`. They live in the committed, encrypted
# apps/worker/secrets.sops.yaml (story 5-5) and reach the worker two ways:
#   pnpm secrets:push:local    # writes the gitignored apps/worker/.dev.vars for `wrangler dev`
#   pnpm secrets:push:worker   # `wrangler secret bulk` to the live worker
# The inventory, with a comment per key, is readable without decrypting:
#   BETTER_AUTH_SECRET   signs every session. The one key here a leak would actually hurt.
#   GOOGLE_CLIENT_IDS    comma-separated audiences for native Google id tokens (not secret).
#   GOOGLE_CLIENT_SECRET the web/desktop OAuth REDIRECT leg. Never reaches the client.
#   MAIL_FROM            the email-OTP From address. Live since 2026-08-25.
#   APPLE_SERVICE_ID / APPLE_TEAM_ID / APPLE_KEY_ID / APPLE_PRIVATE_KEY
#                        Apple WEB sign-in. Apple issues no static client secret — the worker
#                        signs its own from the .p8, so nothing expires. APPLE_CLIENT_SECRET is
#                        a fallback for a pre-generated JWT, and its expiry IS checked.
# D1 and R2 remain wrangler BINDINGS, not connection strings — the app holds no credential.
