# ── Cloud Quran — environment template ────────────────────────────────────────
# Copy to apps/expo/.env and fill in. Secrets move to sops+age in story 7-11;
# until then nothing secret belongs in this file or in .env.
#
# ⚠️ The app reads EXPO_PUBLIC_INSTANT_APP_ID (see src/services/instantdb.ts).
# This file previously declared EXPO_PUBLIC_INSTANTDB_APP_ID, which the code
# never reads — bootstrapping from it produced a non-null-asserted `undefined`
# app id and every InstantDB call failed at runtime.

# InstantDB — the public app id, safe to expose (it is in the client bundle)
EXPO_PUBLIC_INSTANT_APP_ID=

# Cloudflare R2 (audio CDN)
EXPO_PUBLIC_R2_ENDPOINT=

# Sentry (opt-in crash reporting)
EXPO_PUBLIC_SENTRY_DSN=

# CI-only — never in client code, never committed with a value
# INSTANT_ADMIN_TOKEN=
# CLOUDFLARE_API_TOKEN=
